generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id               String          @id @default(cuid())
  name             String
  email            String          @unique
  password         String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  createdTransfers StockTransfer[] @relation("AdminCreatedTransfers")
  createdProductBatches ProductBatch[]
}

model Customer {
  id                 String              @id @default(cuid())
  name               String
  mobile             String              @unique
  email              String?             @unique
  rewardPoints       Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  password           String?
  addresses          Address[]
  cart               Cart?
  notifications      Notification[]
  offlinePurchases   OfflinePurchase[]
  orders             Order[]
  rewardTransactions RewardTransaction[]
  offerClaims        OfferClaim[]
}

model Cart {
  id         String   @id @default(cuid())
  customerId String   @unique
  items      Json     @default("[]")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([updatedAt])
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  label      String?
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String   @default("India")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orders     Order[]  @relation("OrderShippingAddress")

  @@index([customerId])
}

model Vendor {
  id                   String               @id @default(cuid())
  businessName         String
  storeAddress         String
  contactNumber        String
  email                String?              @unique
  businessCategory     String
  identityDocument     String?
  approvalStatus       VendorApprovalStatus @default(PENDING)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  checkoutQR           String?
  ownerName            String?
  password             String?
  notifications        Notification[]
  offlinePurchases     OfflinePurchase[]
  orders               Order[]
  products             Product[]
  destinationTransfers StockTransfer[]      @relation("DestinationTransfers")
  sourceTransfers      StockTransfer[]      @relation("SourceTransfers")
  stockRecords         VendorStock[]
  outletId             String?
  outlet               Outlet?              @relation(fields: [outletId], references: [id])
  stockMovements       StockMovement[]
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  imageUrl  String?
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  products  Product[]
}

model Product {
  id                   String                @id @default(cuid())
  vendorId             String?
  categoryId           String?
  name                 String
  sku                  String?               @unique
  slug                 String                @unique
  brand                String?
  description          String?
  imageUrls            String[]
  tags                 String[]
  skinConcerns         String[]              @default([])
  price                Decimal               @db.Decimal(10, 2)
  discountPrice        Decimal?              @db.Decimal(10, 2)
  status               ProductStatus         @default(ACTIVE)
  featured             Boolean               @default(false)
  discounted           Boolean               @default(false)
  rewardEligible       Boolean               @default(false)
  limitedOffer         Boolean               @default(false)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  benefits             Json?
  faq                  Json?
  ingredients          String?
  defaultMrp           Decimal?              @db.Decimal(10, 2)
  defaultWeight        Decimal?              @db.Decimal(10, 2)
  unit                 String?
  whyWeLoveIt          String?
  showOnline           Boolean               @default(true)
  bestSeller           Boolean               @default(false)
  newArrival           Boolean               @default(false)
  trending             Boolean               @default(false)
  specialOfferType     String?
  linkedProductId      String?
  origin               String?
  offlinePurchaseItems OfflinePurchaseItem[]
  orderItems           OrderItem[]
  category             Category?             @relation(fields: [categoryId], references: [id])
  linkedProduct        Product?              @relation("DealLink", fields: [linkedProductId], references: [id])
  linkedDeals          Product[]             @relation("DealLink")
  vendor               Vendor?               @relation(fields: [vendorId], references: [id])
  stockTransferItems   StockTransferItem[]
  stockRecords         VendorStock[]
  batches              ProductBatch[]
  outletInventories    OutletInventory[]
  stockMovements       StockMovement[]

  @@index([vendorId])
  @@index([categoryId])
  @@index([name])
  @@index([linkedProductId])
}

model VendorStock {
  id        String   @id @default(cuid())
  productId String
  vendorId  String
  quantity  Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, vendorId])
  @@index([productId])
  @@index([vendorId])
}

model Outlet {
  id                String            @id @default(cuid())
  name              String
  code              String            @unique
  address           String?
  city              String?
  state             String?
  pincode           String?
  status            OutletStatus      @default(ACTIVE)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  managers          Vendor[]
  inventories       OutletInventory[]
  stockMovements    StockMovement[]

  @@index([status])
}

model ProductBatch {
  id               String            @id @default(cuid())
  productId        String
  labelCode        String            @unique
  barcodeValue     String            @unique
  qrValue          String            @unique
  batchNo          String
  mrp              Decimal?          @db.Decimal(10, 2)
  ingredients      String?
  productionDate   DateTime?
  expiryDate       DateTime?
  weight           Decimal?          @db.Decimal(10, 2)
  unit             String?
  initialQuantity  Int               @default(0)
  status           BatchStatus       @default(ACTIVE)
  createdByAdminId String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  outletInventories OutletInventory[]
  stockMovements   StockMovement[]
  createdByAdmin   Admin?            @relation(fields: [createdByAdminId], references: [id])

  @@unique([productId, batchNo])
  @@index([productId])
  @@index([status])
  @@index([expiryDate])
}

model OutletInventory {
  id                String       @id @default(cuid())
  outletId          String
  productId         String
  batchId           String
  quantity          Int          @default(0)
  lowStockThreshold Int          @default(5)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  outlet            Outlet       @relation(fields: [outletId], references: [id], onDelete: Cascade)
  product           Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  batch             ProductBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([outletId, productId, batchId])
  @@index([outletId])
  @@index([productId])
  @@index([batchId])
}

model StockMovement {
  id               String               @id @default(cuid())
  outletId         String
  productId        String
  batchId          String
  movementType     StockMovementType
  quantity         Int
  previousQuantity Int
  newQuantity      Int
  reason           String?
  referenceType    StockReferenceType?
  referenceId      String?
  performedById    String?
  createdAt        DateTime             @default(now())
  outlet           Outlet               @relation(fields: [outletId], references: [id], onDelete: Cascade)
  product          Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  batch            ProductBatch         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  performedBy      Vendor?              @relation(fields: [performedById], references: [id])

  @@index([outletId])
  @@index([productId])
  @@index([batchId])
  @@index([movementType])
  @@index([createdAt])
}

model Order {
  id                 String          @id @default(cuid())
  orderNumber        String          @unique
  customerId         String
  vendorId           String?
  addressId          String?
  type               String          @default("Online")
  status             OrderStatus     @default(PLACED)
  subtotal           Decimal         @db.Decimal(10, 2)
  discountAmount     Decimal         @default(0) @db.Decimal(10, 2)
  totalAmount        Decimal         @db.Decimal(10, 2)
  rewardPointsUsed   Int             @default(0)
  rewardPointsEarned Int             @default(0)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deliveredAt        DateTime?
  shippingAddress    Address?        @relation("OrderShippingAddress", fields: [addressId], references: [id])
  customer           Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vendor             Vendor?         @relation(fields: [vendorId], references: [id])
  items              OrderItem[]
  trackingEvents     OrderTracking[]

  @@index([customerId])
  @@index([vendorId])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String?
  name      String
  quantity  Int
  unitPrice Decimal  @db.Decimal(10, 2)
  lineTotal Decimal  @db.Decimal(10, 2)
  isFree    Boolean  @default(false)
  offerType String?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model OrderTracking {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OfflinePurchase {
  id                 String                @id @default(cuid())
  customerId         String?
  vendorId           String
  mobile             String
  amount             Decimal               @db.Decimal(10, 2)
  purchaseDate       DateTime              @default(now())
  linkedAt           DateTime?
  createdAt          DateTime              @default(now())
  customerName       String?
  rewardPointsEarned Int                   @default(0)
  customer           Customer?             @relation(fields: [customerId], references: [id])
  vendor             Vendor                @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  items              OfflinePurchaseItem[]

  @@index([customerId])
  @@index([vendorId])
  @@index([mobile])
}

model OfflinePurchaseItem {
  id                String          @id @default(cuid())
  offlinePurchaseId String
  name              String
  quantity          Int
  unitPrice         Decimal         @db.Decimal(10, 2)
  createdAt         DateTime        @default(now())
  productId         String?
  offlinePurchase   OfflinePurchase @relation(fields: [offlinePurchaseId], references: [id], onDelete: Cascade)
  product           Product?        @relation(fields: [productId], references: [id])

  @@index([offlinePurchaseId])
  @@index([productId])
}

model RewardTransaction {
  id         String          @id @default(cuid())
  customerId String
  type       RewardEntryType
  source     String
  points     Int
  note       String?
  createdAt  DateTime        @default(now())
  sourceId   String?
  customer   Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([sourceId])
}

model Campaign {
  id          String           @id @default(cuid())
  title       String
  description String?
  status      String           @default("draft")
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  banners     HomepageBanner[]
}

model HomepageBanner {
  id         String    @id @default(cuid())
  title      String
  subtitle   String?
  imageUrl   String?
  ctaLabel   String?
  ctaUrl     String?
  isActive   Boolean   @default(true)
  sortOrder  Int       @default(0)
  campaignId String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  campaign   Campaign? @relation(fields: [campaignId], references: [id])

  @@index([campaignId])
}

model Notification {
  id         String               @id @default(cuid())
  audience   NotificationAudience
  channel    NotificationChannel
  customerId String?
  vendorId   String?
  title      String
  message    String
  isRead     Boolean              @default(false)
  createdAt  DateTime             @default(now())
  customer   Customer?            @relation(fields: [customerId], references: [id])
  vendor     Vendor?              @relation(fields: [vendorId], references: [id])

  @@index([vendorId])
}

model HomepageSection {
  id          String   @id @default(cuid())
  title       String
  componentId String   @unique
  type        String   @default("BUILT_IN")
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  settings    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Coupon {
  id            String    @id @default(cuid())
  code          String    @unique
  discountType  String
  discountValue Decimal   @db.Decimal(10, 2)
  minPurchase   Decimal   @default(0) @db.Decimal(10, 2)
  maxUsage      Int?
  usedCount     Int       @default(0)
  expiresAt     DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([code])
}

model StockTransfer {
  id                  String              @id @default(cuid())
  transferNumber      String              @unique
  sourceVendorId      String
  destinationVendorId String
  adminId             String?
  status              StockTransferStatus @default(PENDING)
  notes               String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  dispatchedAt        DateTime?
  receivedAt          DateTime?
  admin               Admin?              @relation("AdminCreatedTransfers", fields: [adminId], references: [id])
  destinationVendor   Vendor              @relation("DestinationTransfers", fields: [destinationVendorId], references: [id])
  sourceVendor        Vendor              @relation("SourceTransfers", fields: [sourceVendorId], references: [id])
  items               StockTransferItem[]

  @@index([sourceVendorId])
  @@index([destinationVendorId])
}

model StockTransferItem {
  id         String        @id @default(cuid())
  transferId String
  productId  String
  quantity   Int
  unitPrice  Decimal?      @db.Decimal(10, 2)
  createdAt  DateTime      @default(now())
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product    Product       @relation(fields: [productId], references: [id])

  @@index([transferId])
  @@index([productId])
}

model Offer {
  id               String   @id @default(cuid())
  type             String   @default("bogo")
  title            String
  accentWord       String   @default("Free")
  badgeText        String   @default("LIMITED OFFER")
  description      String?
  ctaText          String   @default("CLAIM OFFER")
  ctaLink          String?
  endsAt           DateTime
  mainProductImage String?
  freeProductImage String?
  mainProductId    String?
  freeProductId    String?
  isActive         Boolean      @default(true)
  claims           OfferClaim[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model OfferClaim {
  id         String   @id @default(cuid())
  offerId    String
  customerId String
  claimedAt  DateTime @default(now())
  orderId    String?

  offer    Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([offerId, customerId])
  @@index([offerId])
  @@index([customerId])
}

enum VendorApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PLACED
  PAYMENT_VERIFIED
  APPROVED
  CONFIRMED
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum RewardEntryType {
  EARNED
  REDEEMED
  ADJUSTED
}

enum NotificationAudience {
  CUSTOMER
  VENDOR
  ADMIN
}

enum NotificationChannel {
  SMS
  EMAIL
  PUSH
  DASHBOARD
}

enum StockTransferStatus {
  PENDING
  APPROVED
  DISPATCHED
  IN_TRANSIT
  SOURCE_ACKNOWLEDGED
  DESTINATION_CONFIRMED
  COMPLETED
  CANCELLED
}

enum OutletStatus {
  ACTIVE
  INACTIVE
}

enum BatchStatus {
  ACTIVE
  INACTIVE
}

enum StockMovementType {
  ADD
  REDUCE
  SALE
  DAMAGE
  EXPIRED
  CORRECTION
  TRANSFER_IN
  TRANSFER_OUT
}

enum StockReferenceType {
  SCAN
  MANUAL
  SHIPMENT
  ORDER
}
